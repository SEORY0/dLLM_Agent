import builtins
from collections.abc import Iterator, Sequence
from types import TracebackType
from typing import Self

# Minimal torch typing surface for the Stable-DiffCoder worker.

class DType: ...

class Tensor:
    @property
    def shape(self) -> tuple[int, ...]: ...
    def __iter__(self) -> Iterator[Tensor]: ...
    def __getitem__(self, key: object) -> Tensor: ...
    def __setitem__(self, key: object, value: object) -> None: ...
    def __invert__(self) -> Tensor: ...
    def __truediv__(self, divisor: float) -> Tensor: ...
    def detach(self) -> Tensor: ...
    def float(self) -> Tensor: ...
    def reshape(self, *shape: int) -> Tensor: ...
    def tolist(self) -> list[int]: ...
    def sum(self) -> Tensor: ...
    def clone(self) -> Tensor: ...
    def double(self) -> Tensor: ...
    def gather(self, dim: int, index: Tensor) -> Tensor: ...
    def mean(self) -> Tensor: ...
    def kron(self, other: Tensor) -> Tensor: ...
    def masked_fill_(self, mask: Tensor, value: float) -> Tensor: ...
    def unsqueeze(self, dim: int) -> Tensor: ...
    def to(self, *, dtype: DType) -> Tensor: ...
    def index_select(self, dim: int, index: Tensor) -> Tensor: ...
    def eq(self, other: int) -> Tensor: ...
    def nonzero(self, *, as_tuple: builtins.bool = False) -> tuple[Tensor, ...]: ...
    def numel(self) -> int: ...
    def item(self) -> int | float: ...

class Generator:
    def __init__(self, *, device: str) -> None: ...
    def manual_seed(self, seed: int) -> Generator: ...

class Event:
    def __init__(self, *, enable_timing: builtins.bool) -> None: ...
    def record(self) -> None: ...
    def elapsed_time(self, end_event: Event) -> float: ...

class _Cuda:
    def manual_seed_all(self, seed: int) -> None: ...
    def Event(self, *, enable_timing: builtins.bool) -> Event: ...  # noqa: N802 - torch API.
    def synchronize(self) -> None: ...

class _NoGrad:
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

long: DType
bfloat16: DType
bool: DType  # noqa: A001 - torch exposes torch.bool.
inf: float
cuda: _Cuda

def manual_seed(seed: int) -> Generator: ...
def tensor(
    data: Sequence[int] | Sequence[Sequence[int]], *, dtype: DType, device: str
) -> Tensor: ...
def ones(shape: tuple[int, int], *, dtype: DType, device: str) -> Tensor: ...
def tril(input: Tensor) -> Tensor: ...  # noqa: A002 - torch API.
def no_grad() -> _NoGrad: ...
def softmax(input: object, dim: int) -> Tensor: ...  # noqa: A002 - torch API.
def multinomial(
    input: object,  # noqa: A002 - torch API.
    num_samples: int,
    *,
    generator: Generator,
) -> Tensor: ...
