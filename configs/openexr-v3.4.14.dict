# OpenEXR magic and common version/flag words (little-endian).
exr_magic="\x76\x2f\x31\x01"
version_2="\x02\x00\x00\x00"
tiled_flag="\x02\x02\x00\x00"
long_names_flag="\x02\x04\x00\x00"
deep_flag="\x02\x08\x00\x00"
multipart_flag="\x02\x10\x00\x00"

# Required and standard header attribute names.
"channels\x00"
"compression\x00"
"dataWindow\x00"
"displayWindow\x00"
"lineOrder\x00"
"pixelAspectRatio\x00"
"screenWindowCenter\x00"
"screenWindowWidth\x00"
"tiles\x00"
"chunkCount\x00"
"name\x00"
"type\x00"
"version\x00"
"view\x00"
"multiView\x00"
"chromaticities\x00"
"preview\x00"
"timeCode\x00"
"keyCode\x00"

# Attribute type names.
"box2i\x00"
"chlist\x00"
"compression\x00"
"lineOrder\x00"
"float\x00"
"v2f\x00"
"tiledesc\x00"
"string\x00"
"int\x00"
"chromaticities\x00"
"preview\x00"

# Part and channel names observed by the pinned parser.
"scanlineimage\x00"
"tiledimage\x00"
"deepscanline\x00"
"deeptile\x00"
"R\x00"
"G\x00"
"B\x00"
"A\x00"
"Y\x00"
"RY\x00"
"BY\x00"
"Z\x00"
"ZBack\x00"
